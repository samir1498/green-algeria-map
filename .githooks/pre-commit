#!/usr/bin/env sh
set -e

STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -qE "^frontend($|/)"; then
  echo "pre-commit: frontend is a submodule; verify gam-frontend CI and bump the pointer instead"
fi

if echo "$STAGED" | grep -q "^backend-nestjs/"; then
  (cd backend-nestjs && pnpm lint)
fi
